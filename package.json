{
  "name": "@goodandready/dsh-clinebot",
  "version": "0.6.17",
  "description": "DeepSeek Harness companion for ClineBot / ClinePass: dynamic subscription models sync, quota exhaustion warnings, session metrics, dedicated settings page, live usage limits, and /cline slash-command.",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "README.ru.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE",
    "media/visual-verification.png"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cline",
    "clinebot",
    "clinepass",
    "openai-compatible",
    "llm-provider",
    "usage-dashboard",
    "quota-limits"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GooDAnDReaDY/dsh-clinebot.git"
  },
  "scripts": {
    "build:client": "node scripts/build-client.js",
    "test": "node scripts/build-client.js && node --import ./test/_setup.mjs --test test/*.test.js"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.2 <0.2.2-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": ">=0.2.1-rc.2 <0.2.2-0",
      "dshReleases": {
        "0.2.1-rc.2": "compatible",
        "0.2.1-rc.3": "compatible"
      }
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-attachment": ">=0.2.1-rc.2 <0.2.2-0",
    "@deepseek-ai/dsh-commands": ">=0.2.1-rc.2 <0.2.2-0",
    "@deepseek-ai/dsh-credentials": ">=0.2.1-rc.2 <0.2.2-0",
    "@deepseek-ai/dsh-host-webserver": ">=0.2.1-rc.2 <0.2.2-0",
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.2 <0.2.2-0",
    "@deepseek-ai/dsh-settings": ">=0.2.1-rc.2 <0.2.2-0",
    "@deepseek-ai/dsh-web": ">=0.2.1-rc.2 <0.2.2-0",
    "@deepseek-ai/schemastery": "~3.18.5",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-attachment": {
      "optional": true
    },
    "@deepseek-ai/dsh-commands": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-web": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-attachment": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-brand": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "~3.18.5",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "typescript": "^6.0.3"
  },
  "homepage": "https://github.com/GooDAnDReaDY/dsh-clinebot#readme",
  "bugs": {
    "url": "https://github.com/GooDAnDReaDY/dsh-clinebot/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
